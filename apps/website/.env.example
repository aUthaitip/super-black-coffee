# Copy to .env.local. Use a separate deployment/sheet for Preview tests.
# Deploy Apps Script as a Web app and paste its /exec URL here.
CONTACT_APPS_SCRIPT_URL=
# addUser: existing five-column script; signed: bundled apps-script/Code.gs.
CONTACT_APPS_SCRIPT_CONTRACT=addUser
# Same random secret as CONTACT_FORM_SECRET in Apps Script's Script Properties.
# Required only for signed: 32+ characters. Never use NEXT_PUBLIC_ for secrets.
CONTACT_APPS_SCRIPT_SECRET=
NEXT_PUBLIC_SANITY_DATASET=production# Website Sanity project. Development and Preview use development; live uses production.
NEXT_PUBLIC_SANITY_PROJECT_ID=043s7ari
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# On non-Vercel hosting, set to preview or production to enforce dataset separation.
# Vercel deployments are checked automatically using VERCEL_ENV.
SANITY_DEPLOYMENT_ENV=
